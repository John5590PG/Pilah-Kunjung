# Local database (docker compose up -d)
DATABASE_URL=postgresql://pilah:pilah@localhost:5432/pilah?schema=public
# Direct connection (same value locally; on Supabase use Session/Direct host, and on DATABASE_URL use Pooler with ?pgbouncer=true&connection_limit=1)
DIRECT_URL=postgresql://pilah:pilah@localhost:5432/pilah?schema=public

# Example Supabase PostgreSQL URLs (replace [PASSWORD] and [PROJECT_REF]):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Secrets — generate real values, never commit .env
AUTH_SECRET=change-me-min-16-chars
TOKEN_PEPPER=change-me-min-16-chars
APP_BASE_URL=http://localhost:3000

# Seeded synthetic accounts (printed by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=demo-admin-2026
SEED_COORDINATOR_EMAIL=korcam@demo.local
SEED_COORDINATOR_PASSWORD=demo-korcam-2026
SEED_ADVISOR_EMAIL=advisor@demo.local
SEED_ADVISOR_PASSWORD=demo-advisor-2026
